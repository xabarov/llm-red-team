{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-red-team.local/schemas/evaluation-execution.schema.json",
  "title": "Evaluation Execution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "matrix_id", "plan_sha256", "stand_revision", "session_id", "expected_modes", "expected_artifacts", "artifacts"],
  "properties": {
    "schema_version": {"const": "evaluation-execution/v1"},
    "manifest_kind": {"enum": ["live-matrix", "historical-calibration"]},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_path": {"type": "string", "minLength": 1},
    "matrix_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stand_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["completed", "completed-with-failed-gates"]},
    "expected_modes": {
      "type": "array",
      "items": {"enum": ["vulnerable", "protected"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactKey"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifactKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "scenario_id", "repeat_index"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "model", "research_model", "summarization_model", "repeat_index", "scenario_id",
        "attack_class", "carrier", "maturity", "scenario_path", "scenario_sha256",
        "summary_path", "summary_sha256", "evidence_path", "evidence_sha256",
        "evidence_manifest_path", "evidence_manifest_sha256"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "research_model": {"type": "string", "minLength": 1},
        "summarization_model": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "attack_class": {"enum": ["C1", "C2", "C3", "C4"]},
        "carrier": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["replay-ready", "negative-control", "experimental"]},
        "scenario_path": {"type": "string", "minLength": 1},
        "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summary_path": {"type": "string", "minLength": 1},
        "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_manifest_path": {"type": "string", "minLength": 1},
        "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_kind": {"const": "live-matrix"}}},
      "then": {"required": ["matrix_path", "matrix_file_sha256", "matrix_content_sha256"]}
    }
  ]
}
