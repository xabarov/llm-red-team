{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-red-team.local/schemas/evaluation-matrix.schema.json",
  "title": "Evaluation Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "stand_revision", "live", "offline"],
  "properties": {
    "schema_version": {"const": "evaluation-matrix/v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "status": {"enum": ["proposed", "approved"]},
    "stand_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repeats", "modes", "models", "scenarios", "assumptions", "pricing", "budget", "reporting"],
      "properties": {
        "provider": {"const": "openrouter"},
        "repeats": {"type": "integer", "minimum": 1, "maximum": 20},
        "modes": {
          "type": "array",
          "items": {"enum": ["vulnerable", "protected"]},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "runtime_model", "input_usd_per_million", "output_usd_per_million"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "runtime_model": {"type": "string", "pattern": "^openai:"},
              "input_usd_per_million": {"type": "number", "minimum": 0},
              "output_usd_per_million": {"type": "number", "minimum": 0}
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256", "attack_class", "carrier", "maturity", "expected_attempts_by_mode", "calibration"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "attack_class": {"enum": ["C1", "C2", "C3", "C4"]},
              "carrier": {"type": "string", "minLength": 1},
              "maturity": {"enum": ["replay-ready", "negative-control", "experimental"]},
              "expected_attempts_by_mode": {
                "type": "object",
                "additionalProperties": false,
                "required": ["vulnerable", "protected"],
                "properties": {
                  "vulnerable": {"type": "integer", "minimum": 1},
                  "protected": {"type": "integer", "minimum": 1}
                }
              },
              "calibration": {
                "type": "object",
                "additionalProperties": false,
                "required": ["summary_path", "summary_sha256", "evidence_path", "evidence_sha256", "observed_attempts_total", "observed_duration_seconds"],
                "properties": {
                  "summary_path": {"type": "string", "minLength": 1},
                  "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "evidence_path": {"type": "string", "minLength": 1},
                  "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "observed_attempts_total": {"type": "integer", "minimum": 1},
                  "observed_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_llm_calls_per_attempt", "maximum_llm_calls_per_attempt", "expected_input_tokens_per_call", "maximum_input_tokens_per_call", "expected_output_tokens_per_call", "maximum_output_tokens_per_call"],
          "properties": {
            "expected_llm_calls_per_attempt": {"type": "integer", "minimum": 1},
            "maximum_llm_calls_per_attempt": {"type": "integer", "minimum": 1},
            "expected_input_tokens_per_call": {"type": "integer", "minimum": 1},
            "maximum_input_tokens_per_call": {"type": "integer", "minimum": 1},
            "expected_output_tokens_per_call": {"type": "integer", "minimum": 1},
            "maximum_output_tokens_per_call": {"type": "integer", "minimum": 1}
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "retrieved_at"],
          "properties": {
            "source": {"type": "string", "format": "uri"},
            "retrieved_at": {"type": "string", "format": "date"}
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "hard_cap_usd", "proposed_cap_usd", "maximum_wall_time_seconds"],
          "properties": {
            "approved": {"type": "boolean"},
            "hard_cap_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "proposed_cap_usd": {"type": "number", "exclusiveMinimum": 0},
            "maximum_wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confidence_interval", "metrics", "unavailable_without_new_instrumentation", "manual_review_rubric", "manual_review_rubric_sha256"],
          "properties": {
            "confidence_interval": {"const": "wilson-95"},
            "metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
            "unavailable_without_new_instrumentation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "manual_review_rubric": {"type": "string", "minLength": 1},
            "manual_review_rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "case_path", "case_sha256", "modes", "repeats"],
      "properties": {
        "kind": {"const": "offline-memory-defense"},
        "case_path": {"type": "string", "minLength": 1},
        "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modes": {
          "type": "array",
          "items": {"enum": ["none", "write", "read", "write+read"]},
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "repeats": {"type": "integer", "minimum": 1}
      }
    }
  }
}
