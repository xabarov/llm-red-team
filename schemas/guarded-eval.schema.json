{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-red-team.local/schemas/guarded-eval.schema.json",
  "title": "Offline Memory Defense Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "target_user_id",
    "modes",
    "profile",
    "snapshot",
    "oracle"
  ],
  "properties": {
    "schema_version": {
      "const": "guarded-eval/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "target_user_id": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": ["none", "write", "read", "write+read"]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trusted_global_authorities"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "trusted_global_authorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "statement",
          "kind",
          "scope",
          "owner_user_id",
          "source_user_id",
          "authority"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["agent_policy", "semantic", "episodic"]
          },
          "scope": {
            "enum": ["global", "user"]
          },
          "owner_user_id": {
            "type": ["string", "null"]
          },
          "source_user_id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["malicious_ids", "benign_ids"],
      "properties": {
        "malicious_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "benign_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
