# Never commit the real key. Copy this file to .env.
OPENROUTER_API_KEY=

# LangChain init_chat_model format expected by the upstream stand:
# provider:model, where the OpenRouter model slug follows the second colon.
OPENROUTER_RESEARCH_MODEL=openai:openai/gpt-5-mini
OPENROUTER_SUMMARIZATION_MODEL=openai:openai/gpt-5-mini
OPENROUTER_RESEARCH_MODEL_MAX_TOKENS=2048
OPENROUTER_SUMMARIZATION_MODEL_MAX_TOKENS=1024
OPENROUTER_MAX_REACT_TOOL_CALLS=6
