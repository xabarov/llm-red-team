.DS_Store
.cache/
.env
.env.*
!.env.example

.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

tmp/
output/
*.log

# Reproducible G5 machine reports; keep compact reviewed Markdown in Git.
evaluation/plan.json
evaluation/historical-reconstruction.json

# Blinded-review working files may contain private mappings or reviewer ids.
**/review-key.private.json
**/review-packet.json
**/verdict-template.json
**/review-verdict-*.json

# Large/source research artifacts and disposable OCR.
research/papers/original/*
!research/papers/original/README.md
research/papers/extracted/*
!research/papers/extracted/README.md

# Keep raw/private coordination notes local. Only the normalized task description
# belongs in version control.
tz/*
!tz/description.md
