# Локальный OpenAI-compatible endpoint из infra/stand.ollama.yml.
OPENAI_API_KEY=ollama-local
OPENAI_BASE_URL=http://ollama:11434/v1
RESEARCH_MODEL=openai:qwen3:1.7b
SUMMARIZATION_MODEL=openai:qwen3:1.7b
RESEARCH_MODEL_MAX_TOKENS=2048
SUMMARIZATION_MODEL_MAX_TOKENS=1024
MAX_REACT_TOOL_CALLS=4

REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agent_memory
WORKING_MEMORY_TTL=86400

MCP_INVEST_URL=http://localhost:8100
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=https://localhost:8443
KEYCLOAK_REALM=genai-stand
AGENT_CLIENT_ID=agent-service
AGENT_CLIENT_SECRET=agent-service-secret
UI_CLIENT_ID=streamlit-ui
UI_CLIENT_SECRET=streamlit-ui-secret
STREAMLIT_APP_CLIENT_ID=streamlit-app

